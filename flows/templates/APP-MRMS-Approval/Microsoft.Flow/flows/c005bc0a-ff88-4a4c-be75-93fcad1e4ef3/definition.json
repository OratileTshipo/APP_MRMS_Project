{
  "name": "c005bc0a-ff88-4a4c-be75-93fcad1e4ef3",
  "id": "/providers/Microsoft.Flow/flows/c005bc0a-ff88-4a4c-be75-93fcad1e4ef3",
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "Report Approved - Finalize (APP-MRMS)",
    "definition": {
      "metadata": {
        "provisioningMethod": "FromDefinition",
        "creationSource": "Portal",
        "modifiedSources": "Portal"
      },
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": { "defaultValue": {}, "type": "SecureObject" },
        "$connections": { "defaultValue": {}, "type": "Object" }
      },
      "triggers": {
        "When_an_item_is_modified": {
          "recurrence": { "frequency": "Minute", "interval": 3 },
          "evaluatedRecurrence": { "frequency": "Minute", "interval": 3 },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": { "operationMetadataId": "a61588e4-a5d8-4ce1-a1d3-84be04a2beaf" },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "{{SITE_URL}}",
              "table": "{{MR_GUID}}",
              "changeType": "Modified"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnChangedItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Condition_Status_Approved": {
          "runAfter": {},
          "type": "If",
          "expression": {
            "and": [
              { "equals": [ "@triggerBody()?['Status/Value']", "Approved" ] }
            ]
          },
          "actions": {
            "Get_activity": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{ACT_GUID}}",
                  "id": "@triggerBody()?['Activity/Id']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Notify_Contributor_Final": {
              "runAfter": { "Get_activity": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@triggerBody()?['SubmittedBy/EMail']",
                  "emailMessage/Subject": "Your report has been FINAL APPROVED",
                  "emailMessage/Body": "<p>Congratulations! Your monthly report (ID: @{triggerBody()?['ID']}) for activity <b>@{outputs('Get_activity')?['body/Title']}</b> (@{outputs('Get_activity')?['body/ActivityShortDescription']}) has received <b>final approval</b> from the Deputy Director: M&amp;E.</p><p>The approved report is now counted as a final approved report against the activity in line with the project activities.</p><p>Percentage Complete: @{triggerBody()?['PercentageComplete']}%<br>Reporting Month: @{triggerBody()?['ReportingMonth/Value']}<br>Financial Year: @{triggerBody()?['FinancialYear/Value']}</p><p>Regards,<br>APP-MRMS System</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Notify_Supervisor_Final": {
              "runAfter": { "Notify_Contributor_Final": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@outputs('Get_activity')?['body/Supervisor/EMail']",
                  "emailMessage/Subject": "Report received final approval",
                  "emailMessage/Body": "<p>The monthly report (ID: @{triggerBody()?['ID']}) for activity @{outputs('Get_activity')?['body/Title']} received <b>final approval</b> from the Deputy Director: M&amp;E.</p><p>The report is now counted as a final approved report against the activity.</p><p>Regards,<br>APP-MRMS System</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Create_Notification_Contributor": {
              "runAfter": { "Notify_Supervisor_Final": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{NOTIF_GUID}}",
                  "item/Title": "Report final approved",
                  "item/RecipientUser/Claims": "i:0#.f|membership|@{triggerBody()?['SubmittedBy/EMail']}",
                  "item/RelatedEntity": "MonthlyReports:@{triggerBody()?['ID']}",
                  "item/Message": "Your report @{triggerBody()?['ID']} was finally approved and is counted against the activity.",
                  "item/IsRead": false,
                  "item/CreatedDate": "@utcNow()"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Create_Notification_Supervisor": {
              "runAfter": { "Create_Notification_Contributor": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{NOTIF_GUID}}",
                  "item/Title": "Report received final approval",
                  "item/RecipientUser/Claims": "i:0#.f|membership|@{outputs('Get_activity')?['body/Supervisor/EMail']}",
                  "item/RelatedEntity": "MonthlyReports:@{triggerBody()?['ID']}",
                  "item/Message": "Report @{triggerBody()?['ID']} for @{outputs('Get_activity')?['body/Title']} received final approval from M&E.",
                  "item/IsRead": false,
                  "item/CreatedDate": "@utcNow()"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Complete_Activity": {
              "runAfter": { "Create_Notification_Supervisor": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{ACT_GUID}}",
                  "id": "@triggerBody()?['Activity/Id']",
                  "item/Status": "Completed",
                  "item/Active": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "UpdateItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Write_AuditLog": {
              "runAfter": { "Complete_Activity": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{AUDIT_GUID}}",
                  "item/Title": "StatusChange MonthlyReports:@{triggerBody()?['ID']}",
                  "item/EntityType": "MonthlyReport",
                  "item/EntityId": "@{triggerBody()?['ID']}",
                  "item/Action": "StatusChange",
                  "item/ActionBy/Claims": "i:0#.f|membership|@{triggerBody()?['ReviewedBy/EMail']}",
                  "item/ActionDate": "@utcNow()",
                  "item/Reason": "Approved - Final"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {}
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "shared_sharepointonline",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified",
        "apiName": "sharepointonline"
      },
      "shared_office365": {
        "connectionName": "shared_office365",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified",
        "apiName": "office365"
      }
    }
  }
}

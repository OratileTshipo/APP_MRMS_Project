{
  "name": "35502f2b-26e0-4d6b-8099-d409277f9dfb",
  "id": "/providers/Microsoft.Flow/flows/35502f2b-26e0-4d6b-8099-d409277f9dfb",
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "Supervisor Approved - Route to Deputy (APP-MRMS)",
    "definition": {
      "metadata": {
        "provisioningMethod": "FromDefinition",
        "creationSource": "Portal",
        "modifiedSources": "Portal"
      },
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": { "defaultValue": {}, "type": "SecureObject" },
        "$connections": { "defaultValue": {}, "type": "Object" }
      },
      "triggers": {
        "When_an_item_is_modified": {
          "recurrence": { "frequency": "Minute", "interval": 3 },
          "evaluatedRecurrence": { "frequency": "Minute", "interval": 3 },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": { "operationMetadataId": "a61588e4-a5d8-4ce1-a1d3-84be04a2beaf" },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "{{SITE_URL}}",
              "table": "{{MR_GUID}}",
              "changeType": "Modified"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnChangedItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Condition_Status_SupervisorApproved": {
          "runAfter": {},
          "type": "If",
          "expression": {
            "and": [
              { "equals": [ "@triggerBody()?['Status/Value']", "SupervisorApproved" ] }
            ]
          },
          "actions": {
            "Get_activity": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{ACT_GUID}}",
                  "id": "@triggerBody()?['Activity/Id']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Get_deputy": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{USERS_GUID}}",
                  "filterQuery": "Role eq 'DeputyDirectorME'"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Notify_Deputy": {
              "runAfter": {
                "Get_activity": ["Succeeded"],
                "Get_deputy": ["Succeeded"]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@outputs('Get_deputy')?['body/value'][0]['UserAccount/EMail']",
                  "emailMessage/Subject": "Monthly report awaiting M&E approval",
                  "emailMessage/Body": "<p>A monthly report has been approved by the Supervisor and is now awaiting your final M&E approval.</p><p>Activity: @{outputs('Get_activity')?['body/Title']} (@{outputs('Get_activity')?['body/ActivityShortDescription']})<br>Report ID: @{triggerBody()?['ID']}<br>Reporting Month: @{triggerBody()?['ReportingMonth/Value']}<br>Financial Year: @{triggerBody()?['FinancialYear/Value']}<br>Submitted by: @{triggerBody()?['SubmittedBy/EMail']}<br>Supervisor: @{outputs('Get_activity')?['body/Supervisor/Value']}</p><p>Please review and approve or reject this report in your APP-MRMS Approval Queue.</p><p>Regards,<br>APP-MRMS System</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Notify_Contributor": {
              "runAfter": { "Notify_Deputy": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@triggerBody()?['SubmittedBy/EMail']",
                  "emailMessage/Subject": "Your report was approved by your Supervisor",
                  "emailMessage/Body": "<p>Your monthly report (ID: @{triggerBody()?['ID']}) for activity @{outputs('Get_activity')?['body/Title']} was approved by your Supervisor and has been forwarded to the Deputy Director: M&E for final approval.</p><p>You will be notified once the final decision is made.</p><p>Regards,<br>APP-MRMS System</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Create_Notification_Deputy": {
              "runAfter": { "Notify_Contributor": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{NOTIF_GUID}}",
                  "item/Title": "Monthly report awaiting M&E approval",
                  "item/RecipientUser/Claims": "i:0#.f|membership|@{outputs('Get_deputy')?['body/value'][0]['UserAccount/EMail']}",
                  "item/RelatedEntity": "MonthlyReports:@{triggerBody()?['ID']}",
                  "item/Message": "Report @{triggerBody()?['ID']} for @{outputs('Get_activity')?['body/Title']} is awaiting your final M&E approval.",
                  "item/IsRead": false,
                  "item/CreatedDate": "@utcNow()"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Create_Notification_Contributor": {
              "runAfter": { "Create_Notification_Deputy": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{NOTIF_GUID}}",
                  "item/Title": "Report forwarded to M&E",
                  "item/RecipientUser/Claims": "i:0#.f|membership|@{triggerBody()?['SubmittedBy/EMail']}",
                  "item/RelatedEntity": "MonthlyReports:@{triggerBody()?['ID']}",
                  "item/Message": "Your report @{triggerBody()?['ID']} was approved by your Supervisor and forwarded to the Deputy Director: M&E.",
                  "item/IsRead": false,
                  "item/CreatedDate": "@utcNow()"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Write_AuditLog": {
              "runAfter": { "Create_Notification_Contributor": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "{{SITE_URL}}",
                  "table": "{{AUDIT_GUID}}",
                  "item/Title": "StatusChange MonthlyReports:@{triggerBody()?['ID']}",
                  "item/EntityType": "MonthlyReport",
                  "item/EntityId": "@{triggerBody()?['ID']}",
                  "item/Action": "StatusChange",
                  "item/ActionBy/Claims": "i:0#.f|membership|@{triggerBody()?['ReviewedBy/EMail']}",
                  "item/ActionDate": "@utcNow()",
                  "item/Reason": "SupervisorApproved"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {}
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "shared_sharepointonline",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified",
        "apiName": "sharepointonline"
      },
      "shared_office365": {
        "connectionName": "shared_office365",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified",
        "apiName": "office365"
      }
    }
  }
}
